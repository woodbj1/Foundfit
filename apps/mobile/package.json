{
  "name": "foundfit-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "cross-env APP_VARIANT=development expo start",
    "start:preview": "cross-env APP_VARIANT=preview expo start",
    "start:production": "cross-env APP_VARIANT=production expo start",
    "android": "cross-env APP_VARIANT=development expo start --android",
    "ios": "cross-env APP_VARIANT=development expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "build:ios:simulator": "npx eas build --platform ios --profile simulator",
    "build:ios:preview": "npx eas build --platform ios --profile preview",
    "build:android:preview": "npx eas build --platform android --profile preview",
    "build:ios:production": "npx eas build --platform ios --profile production",
    "build:android:production": "npx eas build --platform android --profile production",
    "submit:ios:production": "npx eas submit --platform ios --profile production",
    "submit:android:production": "npx eas submit --platform android --profile production"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "@supabase/supabase-js": "^2.102.1",
    "date-fns": "^4.1.0",
    "expo": "~55.0.15",
    "expo-calendar": "~55.0.14",
    "expo-constants": "~55.0.13",
    "expo-font": "~55.0.6",
    "expo-linking": "~55.0.13",
    "expo-router": "~55.0.12",
    "expo-splash-screen": "~55.0.18",
    "expo-status-bar": "~55.0.5",
    "expo-system-ui": "~55.0.15",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.4",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "cross-env": "^10.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
